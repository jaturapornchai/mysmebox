# MySMEBox v1 — ตัวอย่างค่าตั้งระบบ (ค่าปลอมทั้งหมด คัดลอกเป็น .env แล้วแก้ค่าจริง ห้าม commit .env)
NODE_ENV=development
PORT=3850
HOST=127.0.0.1
# production ให้ Caddy เสิร์ฟไฟล์ public/ แล้วตั้ง SERVE_STATIC=0
SERVE_STATIC=1
# โดเมนที่อนุญาตให้ส่งคำขอเปลี่ยนข้อมูล (ว่าง = ยอมทุก origin ใช้ตอน dev)
APP_ORIGIN=https://www.mysmebox.com
# cookie Secure (ค่าเริ่มต้น true เมื่อ NODE_ENV=production)
COOKIE_SECURE=

# PostgreSQL: ใช้ DATABASE_URL หรือ PG_* อย่างใดอย่างหนึ่ง
DATABASE_URL=postgres://postgres:change_me@127.0.0.1:5432/mysmebox # pragma: allowlist secret
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=mysmebox
PG_USER=postgres
PG_PASSWORD=change_me # pragma: allowlist secret
# DB แยกสำหรับ npm test (ถูกลบ/สร้างใหม่ทุกครั้งที่รันเทส)
TEST_DATABASE_URL=postgres://postgres:change_me@127.0.0.1:5432/mysmebox_test # pragma: allowlist secret

# MinIO (ไม่ตั้ง = อัปโหลดรูปตอบ 503 STORAGE_DISABLED ส่วนอื่นใช้ได้ปกติ)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_BUCKET=mysmebox
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here # pragma: allowlist secret
MINIO_SECRET_KEY=your_minio_secret_key_here # pragma: allowlist secret

# Google Login (ไม่ตั้ง = ปุ่ม Google ปิด, ใช้ร้านทดลองได้)
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Ollama Cloud AI (ไม่ตั้ง key = AI ตอบ 503 AI_DISABLED)
OLLAMA_API_URL=https://ollama.com/api/chat
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=your_ollama_cloud_api_key_here # pragma: allowlist secret
